{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lol-player-viewer-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["RIOT_API_KEY"]
  }
}
